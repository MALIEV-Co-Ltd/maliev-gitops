{
  "schemaVersion": 1,
  "valuesOmitted": true,
  "sourceBoundary": "Legacy.Maliev.* application configuration and runtime projection names; values are intentionally excluded",
  "classes": {
    "jwt-standard": {
      "configurationPaths": ["Jwt:Issuer", "Jwt:Audience", "Jwt:PublicKey"],
      "secretProperties": ["legacy-jwt-issuer", "legacy-jwt-audience", "legacy-jwt-public-key"],
      "classification": "single-secret-backed"
    },
    "jwt-auth": {
      "configurationPaths": ["Jwt:Issuer", "Jwt:Audience", "Jwt:PrivateKeyPem", "Jwt:KeyId"],
      "secretProperties": ["legacy-jwt-issuer", "legacy-jwt-audience", "legacy-jwt-private-key", "legacy-jwt-key-id"],
      "classification": "single-secret-backed"
    },
    "jwt-key-id": {
      "configurationPaths": ["Jwt:KeyId"],
      "secretProperties": ["legacy-jwt-key-id"],
      "classification": "single-secret-backed"
    },
    "redis": {
      "configurationPaths": ["ConnectionStrings:redis"],
      "secretProperties": ["legacy-redis-password"],
      "classification": "composite-connection-string-secret-component"
    },
    "service-client-web": {
      "configurationPaths": ["ServiceAuthentication:ClientSecret"],
      "secretProperties": ["legacy-web-service-client-secret"],
      "classification": "single-secret-backed"
    },
    "service-client-intranet": {
      "configurationPaths": ["ServiceAuthentication:ClientSecret"],
      "secretProperties": ["legacy-intranet-service-client-secret"],
      "classification": "single-secret-backed"
    },
    "service-client-quotation": {
      "configurationPaths": ["ServiceAuthentication:ClientSecret"],
      "secretProperties": ["legacy-quotation-service-client-secret"],
      "classification": "single-secret-backed"
    },
    "service-client-accounting": {
      "configurationPaths": ["ServiceAuthentication:ClientSecret"],
      "secretProperties": ["legacy-accounting-service-client-secret"],
      "classification": "single-secret-backed"
    },
    "auth-service-client-hashes": {
      "configurationPaths": [
        "ServiceClients:Clients:legacy-accounting:SecretSha256",
        "ServiceClients:Clients:legacy-intranet:SecretSha256",
        "ServiceClients:Clients:legacy-quotation:SecretSha256",
        "ServiceClients:Clients:legacy-web:SecretSha256"
      ],
      "secretProperties": [
        "legacy-service-client-legacy-accounting-secret-sha256",
        "legacy-service-client-legacy-intranet-secret-sha256",
        "legacy-service-client-legacy-quotation-secret-sha256",
        "legacy-service-client-legacy-web-secret-sha256"
      ],
      "classification": "runtime-only-auth-consumer"
    },
    "data-protection-web": {
      "configurationPaths": ["DataProtection:CertificatePfxBase64", "DataProtection:CertificatePassword"],
      "secretProperties": ["legacy-web-data-protection-certificate-pfx-base64", "legacy-web-data-protection-certificate-password"],
      "classification": "single-secret-backed"
    },
    "data-protection-intranet": {
      "configurationPaths": ["DataProtection:CertificatePfxBase64", "DataProtection:CertificatePassword"],
      "secretProperties": ["legacy-intranet-data-protection-certificate-pfx-base64", "legacy-intranet-data-protection-certificate-password"],
      "classification": "single-secret-backed"
    },
    "google-maps-web": {
      "configurationPaths": ["GoogleMaps:EmbedApiKey"],
      "secretProperties": ["legacy-web-google-maps-embed-api-key"],
      "classification": "single-secret-backed"
    },
    "google-maps-intranet": {
      "configurationPaths": ["GoogleMaps:BrowserApiKey"],
      "secretProperties": ["legacy-intranet-google-maps-browser-api-key"],
      "classification": "single-secret-backed"
    },
    "recaptcha-web": {
      "configurationPaths": ["Recaptcha:SiteKey", "Recaptcha:ProjectId"],
      "secretProperties": ["legacy-web-recaptcha-site-key", "legacy-web-recaptcha-project-id"],
      "classification": "single-secret-backed"
    },
    "google-identity-auth": {
      "configurationPaths": ["GoogleIdentity:Employee:HostedDomain", "GoogleIdentity:Employee:Audiences:intranet"],
      "secretProperties": ["legacy-google-identity-employee-hosted-domain", "legacy-google-identity-employee-audience-intranet"],
      "classification": "single-secret-backed"
    },
    "google-identity-client-id-runtime": {
      "configurationPaths": [],
      "secretProperties": ["legacy-google-identity-client-id"],
      "classification": "runtime-only-apphost-routing"
    },
    "google-identity-intranet": {
      "configurationPaths": ["Authentication:Google:ClientId"],
      "secretProperties": ["legacy-google-identity-client-id"],
      "classification": "single-secret-backed"
    },
    "brevo": {
      "configurationPaths": ["Brevo:ApiKey"],
      "secretProperties": ["legacy-notification-brevo-api-key"],
      "classification": "single-secret-backed"
    }
  },
  "databaseConnectionClass": {
    "classification": "composite-connection-string-secret-component",
    "configurationPathPrefix": "ConnectionStrings:",
    "note": "Host, port, database and pool settings are non-secret runtime configuration; only the username/password components are projected from maliev-legacy-secrets."
  },
  "services": [
