{
  "contractVersion": 1,
  "secretManager": {
    "project": "maliev-website",
    "secret": "maliev-legacy-secrets",
    "replication": "automatic",
    "payloadFormat": "flat-json",
    "valuesOmitted": true
  },
  "rules": {
    "externalSecretRemoteRefKey": "maliev-legacy-secrets",
    "activeOverlayMayReference": "presentPropertiesOnly",
    "dynamicSessionValuesAreForbidden": [
      "access-tokens",
      "refresh-tokens",
      "cookies",
      "user-session-identifiers"
    ],
    "workloadIdentityReplacesServiceAccountKeyFiles": true,
    "propertyNamesAreNotCredentials": true,
    "nonSecretRuntimeConfiguration": [
      "gke-workload-identity-for-google-cloud-storage",
      "google-cloud-storage-bucket-and-object-names"
    ],
    "sourceOnlyCredentialsMustNotBeCopied": [
      "legacy-sql-server-connection-strings",
      "legacy-source-service-account-key-files"
    ],
    "pairedServiceCredentialProperties": [
      {
        "clientId": "legacy-web",
        "rawProperty": "legacy-web-service-client-secret",
        "hashProperty": "legacy-service-client-legacy-web-secret-sha256"
      },
      {
        "clientId": "legacy-intranet",
        "rawProperty": "legacy-intranet-service-client-secret",
        "hashProperty": "legacy-service-client-legacy-intranet-secret-sha256"
      },
      {
